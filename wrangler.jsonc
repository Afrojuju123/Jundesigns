{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jundesigns",
  "main": "worker.ts",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jundesigns-db",
      "database_id": "a033c6a6-13e5-4c10-aa67-df5b41682e02",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": [
      "*/10 * * * *",
      "*/15 * * * *",
      "0 6 * * *"
    ]
  },
  "observability": {
    "enabled": true
  }
}
